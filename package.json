{
  "name": "raceme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/index.ts",
    "build": "vite build",
    "start": "bun src/index.ts",
    "check": "biome check . && tsc",
    "test": "bun test --conditions browser src",
    "test:e2e": "vite build && bun test --timeout 30000 e2e",
    "audit": "vite build && bun scripts/audit.ts"
  },
  "dependencies": {
    "lucide-solid": "^1.61.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@EDPS/website-evidence-collector": "4.5.0",
    "@biomejs/biome": "^2.6.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@solidjs/testing-library": "^0.8.10",
    "@types/bun": "^1.4.4",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "axe-core": "^4.14.0",
    "pa11y": "10.0.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
