{
  "name": "raceme",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "vite build && bun scripts/audit.ts",
    "build": "vite build",
    "check": "biome check . && tsc",
    "dev": "vite",
    "dev:server": "bun --watch src/index.ts",
    "release": "rm -rf release && vite build --outDir release/client --emptyOutDir && bun run release:server && bun run release:pack",
    "release:pack": "git rev-parse HEAD > release/commit && tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner --mode=u=rwX,go=rX -C release -c . | gzip -n > raceme.tar.gz",
    "release:server": "bun build src/index.ts --target bun --outfile release/server.js",
    "start": "bun src/index.ts",
    "test": "bun test --conditions browser src",
    "test:e2e": "vite build && bun test --timeout 30000 e2e"
  },
  "dependencies": {
    "lucide-solid": "^1.61.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@EDPS/website-evidence-collector": "4.5.0",
    "@biomejs/biome": "^2.6.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@solidjs/testing-library": "^0.8.10",
    "@types/bun": "^1.4.4",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "axe-core": "^4.14.0",
    "pa11y": "10.0.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
