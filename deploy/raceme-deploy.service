[Unit]
Description=Prepare the newest attested raceme release and switch to it when no room is open
After=network-online.target raceme.service
Wants=network-online.target

[Service]
Type=oneshot
User=raceme
Group=raceme
ExecStart=/usr/local/lib/raceme/deploy.sh
# Runs as root, which stopping and starting raceme.service needs.
ExecStartPost=+/usr/local/lib/raceme/swap.sh
TimeoutStartSec=10min

MemoryMax=512M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/raceme
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
